<?xml version="1.0" encoding="UTF-8"?>
<!-- DiscordClient 的 Velocity 版（proxy 用）。
     Velocity 4 的 API 是 Java 25 編譯的，Paper 1.21.4（Java 21）讀到 Java 25 的類別會整顆 jar 載入失敗，
     所以 proxy 用的另外建一顆 jar；Paper 版照舊在上一層的 pom.xml。
     版號和上一層的 pom.xml 保持相同（改版號時兩個一起改）。
     建置：mvn -f velocity/pom.xml package（要 JDK 25）→ velocity/target/DiscordClient-Velocity-<版號>.jar -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>xyz.nagiasu.discordclient</groupId>
    <artifactId>discordclient-velocity</artifactId>
    <version>261026.1</version>
    <name>DiscordClient-Velocity</name>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>4.3.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>6.7.0</version>
            <!-- 和上一層 pom.xml 相同的排除（語音套件用不到；SLF4J 用 Velocity 自帶的 2.x） -->
            <exclusions>
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.crypto.tink</groupId>
                    <artifactId>tink</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <finalName>DiscordClient-Velocity-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- 和 Paper 版共用的類別（DiscordClientApi）放在上一層的 src/main/java，這裡只挑要的那幾個編譯 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>shared-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <includes>
                        <include>xyz/nagiasu/discordclient/DiscordClientApi.java</include>
                        <include>xyz/nagiasu/discordclient/DiscordVelocity.java</include>
                    </includes>
                    <!-- velocity-plugin.json 自己寫在 resources（版號從 pom 帶入），不用註解產生 -->
                    <proc>none</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- 不改套件名：別的 Velocity 插件（Nagi_Chat、Nagi_ProxyFeature、Nagi_AdminRecord）
                                 直接用這顆 jar 裡的 JDA -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
